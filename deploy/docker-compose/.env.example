# ============================================================
# JustScan — docker-compose environment variables
# Copy this file to .env and fill in the values.
# ============================================================

# Password for PostgreSQL and the backend database connection.
POSTGRES_PASSWORD=change-me-in-production

# Generate each with: openssl rand -hex 32
BACKEND_JWT_SECRET=change-me-in-production
BACKEND_ENCRYPTION_KEY=change-me-in-production-64-char-hex-replace-this-with-real-value

# Comma-separated browser origins. The first is used for OIDC redirects and links.
BACKEND_ALLOW_ORIGINS=http://localhost

# Optional backend runtime tuning.
# BACKEND_LOG_LEVEL=info
# BACKEND_SCANNER_CONCURRENCY=2
# BACKEND_SCANNER_DB_MAX_AGE_HOURS=7
# BACKEND_SCANNER_SCAN_CACHE_CLEANUP_HOURS=24
# BACKEND_VULN_KB_NVD_API_KEY=

# Pin to a specific release tag (e.g. v1.2.3). Defaults to latest.
# JUSTSCAN_VERSION=latest

# Optional: change the host port nginx listens on (default 80)
# HTTP_PORT=80
